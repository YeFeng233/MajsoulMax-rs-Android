+    async fn fetch_asset(&self, original: &str, name: &str, mirror: bool) -> Result<Bytes> {
+        let source = url::Url::parse(original)?;
+        anyhow::ensure!(source.scheme() == "https" && source.host_str() == Some("github.com"),
+            "Unexpected GitHub asset URL");
+        let target = if mirror {
+            let prefix = url::Url::parse(self.github_mirror.trim())?;
+            anyhow::ensure!(prefix.scheme() == "https" && prefix.host_str().is_some()
+                && prefix.username().is_empty() && prefix.password().is_none()
+                && prefix.query().is_none() && prefix.fragment().is_none(),
+                "Mirror must be an HTTPS URL prefix without credentials, query or fragment");
+            format!("{}/{}", prefix.as_str().trim_end_matches('/'), original)
+        } else {
+            original.to_owned()
+        };
+        let client = self.create_github_client()?;
+        let mut request = client.get(target).timeout(std::time::Duration::from_secs(15));
+        // A token belongs only to GitHub, never to a third-party mirror.
+        if !mirror && !self.github_token.is_empty() {
+            request = request.header("Authorization", format!("Bearer {}", self.github_token))
+                .header("X-GitHub-Api-Version", "2022-11-28");
+        }
+        let bytes = request.send().await?.error_for_status()?.bytes().await?;
+        // Reject HTML error pages served with status 200 before replacing data.
+        if name == "liqi.json" {
+            let json: Value = serde_json::from_slice(&bytes)?;
+            anyhow::ensure!(json.get("nested").is_some(), "Invalid liqi JSON");
+        } else {
+            let descriptor = FileDescriptorSet::decode(bytes.as_ref())?;
+            anyhow::ensure!(!descriptor.file.is_empty(), "Empty protocol descriptor");
+        }
+        Ok(bytes)
+    }
