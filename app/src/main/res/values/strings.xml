    <!-- Certificate -->
    <string name="cert_title">根证书</string>
    <string name="cert_intro">MITM 代理需要用自己的根证书重新签发 HTTPS，因此必须先让系统信任 hudsucker 证书。</string>
    <string name="cert_state_trusted">证书已在系统信任列表中</string>
    <string name="cert_state_untrusted">证书尚未安装</string>
    <string name="cert_install">安装证书</string>
    <string name="cert_open_settings">打开系统证书设置</string>
    <string name="cert_export">导出到「下载」目录</string>
    <string name="cert_exported">已导出：%1$s</string>
    <string name="cert_export_failed">导出失败：%1$s</string>
    <string name="cert_copy_fingerprint">复制指纹</string>
    <string name="cert_copied">已复制到剪贴板</string>
    <string name="cert_detail_subject">主题</string>
    <string name="cert_detail_issuer">签发者</string>
    <string name="cert_detail_valid">有效期</string>
    <string name="cert_detail_sha256">SHA-256 指纹</string>
    <string name="cert_manual_title">手动安装步骤</string>
    <string name="cert_manual_steps">1. 点上面的「安装证书」，系统会弹出安装框；\n2. 若没有弹框，点「打开系统证书设置」，选择 安全 → 加密与凭据 → 安装证书 → CA 证书；\n3. 在文件选择器里挑选已导出到「下载」目录的 hudsucker.cer；\n4. 系统会提示「网络可能被监控」，确认即可。</string>
    <string name="cert_warning_title">关于 Android 7 以上的限制</string>
    <string name="cert_warning_body">用户安装的 CA 只对「明确信任用户证书」的应用生效。浏览器（含本应用内置浏览器）可以正常工作；部分游戏客户端会忽略用户 CA，此时只能用内置浏览器方案，或在已 root 的设备上把证书移到系统信任区。</string>
    <string name="cert_install_unsupported">当前系统未提供证书安装入口，请改用手动安装。</string>

